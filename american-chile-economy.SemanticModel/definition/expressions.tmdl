expression src_chile_state =
		let
		    Appended = Table.Combine({
		        src_chile_acres_planted,
		        src_chile_acres_harvested,
		        src_chile_yield,
		        src_chile_price,
		        src_chile_production_cwt,
		        src_chile_production_usd
		    }),
		    Trimmed = Table.TransformColumns(Appended, {{"value_raw", Text.Trim, type text}}),
		    Pivoted = Table.Pivot(Trimmed, List.Distinct(Trimmed[metric]), "metric", "value_raw")
		in
		    Pivoted
	lineageTag: acaa8615-464c-4817-9a9c-80dce59f58a8

