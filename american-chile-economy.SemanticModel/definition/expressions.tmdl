expression src_cash_rents =
		let
		        Source = Csv.Document(
		        File.Contents(SourceFolder & "\" & SourceFile),
		        [Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    RemovedDeadColumns = Table.RemoveColumns(#"Promoted Headers",{"Program", "Period", "Week Ending", "Geo Level", "Zip Code", "Region",
		        "watershed_code", "Watershed", "Commodity", "Domain", "Domain Category"}),
		    UnpivotedMeasures = Table.UnpivotOtherColumns(RemovedDeadColumns, {"Year", "State", "State ANSI", "Ag District", "Ag District Code",
		        "County", "County ANSI"}, "Attribute", "Value"),
		    #"Renamed Columns" = Table.RenameColumns(UnpivotedMeasures,{{"Attribute", "measure_column"}, {"Value", "value_text"}}),
		    CleanedMeasureValues = Table.TransformColumns(
		        #"Renamed Columns",
		        {{"value_text",
		          each if _ = "" then null else Number.FromText(Text.Replace(_, ",", "")),
		          type number}}
		    ),
		    RenamedValueColumn = Table.RenameColumns(
		        CleanedMeasureValues, {{"value_text", "measure_value"}}
		    ),
		        MeasureMap = #table(
		        type table [source_column = text, land_category_code = text, metric = text],
		        {
		            {"RENT, CASH, CROPLAND, IRRIGATED - EXPENSE, MEASURED IN $ / ACRE  -  <b>VALUE</b>",      "CROPLAND_IRRIGATED",     "VALUE"},
		            {"RENT, CASH, CROPLAND, IRRIGATED - EXPENSE, MEASURED IN $ / ACRE  -  <b>CV (%)</b>",     "CROPLAND_IRRIGATED",     "CV"},
		            {"RENT, CASH, CROPLAND, NON-IRRIGATED - EXPENSE, MEASURED IN $ / ACRE  -  <b>VALUE</b>",  "CROPLAND_NON_IRRIGATED", "VALUE"},
		            {"RENT, CASH, CROPLAND, NON-IRRIGATED - EXPENSE, MEASURED IN $ / ACRE  -  <b>CV (%)</b>", "CROPLAND_NON_IRRIGATED", "CV"},
		            {"RENT, CASH, PASTURELAND - EXPENSE, MEASURED IN $ / ACRE  -  <b>VALUE</b>",              "PASTURELAND",            "VALUE"},
		            {"RENT, CASH, PASTURELAND - EXPENSE, MEASURED IN $ / ACRE  -  <b>CV (%)</b>",             "PASTURELAND",            "CV"}
		        }
		    ),
		    MappedMeasures = Table.Join(
		        RenamedValueColumn, "measure_column",
		        MeasureMap, "source_column",
		        JoinKind.LeftOuter
		    ),
		    RemovedSourceColumns = Table.RemoveColumns(MappedMeasures, {"measure_column", "source_column"}),
		        PivotedMetrics = Table.Pivot(
		        RemovedSourceColumns,
		        {"VALUE", "CV"},
		        "metric",
		        "measure_value"
		    ),
		    RenamedMetrics = Table.RenameColumns(
		        PivotedMetrics,
		        {{"VALUE", "rent_usd_per_acre"}, {"CV", "cv_pct"}}
		    ),
		        RemovedNullRents = Table.SelectRows(
		        RenamedMetrics,
		        each [rent_usd_per_acre] <> null
		    )
		in
		    RemovedNullRents
	lineageTag: aacf1509-65fc-4ab8-a14c-55483722194b

