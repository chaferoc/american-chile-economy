table chk_row_counts
	lineageTag: 97f0019b-fe5c-4bf7-a6ad-771c8b56937b

	column check
		dataType: string
		lineageTag: 3282e4c6-62fe-4512-9392-8b9223f94b11
		summarizeBy: none
		sourceColumn: check

		annotation SummarizationSetBy = Automatic

	column actual
		dataType: double
		lineageTag: a8164416-c8cf-4cec-98d7-5f00664b183a
		summarizeBy: sum
		sourceColumn: actual

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column expected
		dataType: double
		lineageTag: 83575ab7-6722-4dd5-90a9-7dd0e4619e44
		summarizeBy: sum
		sourceColumn: expected

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column delta
		dataType: int64
		formatString: 0
		lineageTag: 1d5005f8-f137-48c3-ae97-871a19f0da3e
		summarizeBy: sum
		sourceColumn: delta

