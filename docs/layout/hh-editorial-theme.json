{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "H&H Editorial",
  "dataColors": [
    "#A6261C",
    "#3D6B8C",
    "#C08A2D",
    "#6E8B3D",
    "#4F7F3A",
    "#7A7A7A",
    "#C9D7B8",
    "#8FAF6E"
  ],
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#A6261C",
  "textClasses": {
    "title": {
      "fontFace": "Georgia",
      "fontSize": 12,
      "color": "#1A1A1A"
    },
    "label": {
      "fontFace": "Segoe UI"
    },
    "callout": {
      "fontFace": "Segoe UI"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "fontWeight": "bold"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "title": [
          {
            "alignment": "left",
            "fontFamily": "Georgia",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            }
          }
        ],
        "subTitle": [
          {
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#555555"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "gridlineThickness": 1,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#555555"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "gridlineThickness": 1,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#555555"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            }
          }
        ]
      }
    }
  }
}
